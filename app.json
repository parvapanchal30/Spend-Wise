{
  "expo": {
    "name": "SpendWise",
    "slug": "spendwise",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "spendwise",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendwise.prototype"
    },
    "android": {
      "package": "com.spendwise.prototype",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select a receipt image to attach to your purchase.",
          "cameraPermission": "Take a photo of a receipt to add it to SpendWise.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      "expo-notifications"
    ]
  }
}
